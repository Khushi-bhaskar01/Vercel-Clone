# ============================================================
#  Vercel Clone - environment variables (copy to .env and fill in)
# ============================================================

# ---------- AWS ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-key
S3_BUCKET=your-bucket-name

# ---------- ECS (api-server launches build tasks) ----------
ECS_CLUSTER_ARN=arn:aws:ecs:<region>:<account-id>:cluster/<cluster-name>
ECS_TASK_ARN=arn:aws:ecs:<region>:<account-id>:task-definition/<task-name>
ECS_SUBNETS=subnet-xxxx,subnet-yyyy
ECS_SECURITY_GROUPS=sg-xxxx
ECS_CONTAINER_NAME=image-builder

# ---------- Redis / Valkey (build log pub/sub) ----------
REDIS_URL=rediss://default:<password>@<host>:<port>

# ---------- api-server ----------
API_PORT=9000
SOCKET_PORT=9002
FRONTEND_URL=http://localhost:5173

# ---------- s3-reverse-proxy ----------
PROXY_PORT=8000
PROXY_DOMAIN=localhost:8000

# ---------- frontend (Vite - only VITE_* vars reach the browser) ----------
VITE_API_URL=http://localhost:9000
VITE_SOCKET_URL=http://localhost:9002
